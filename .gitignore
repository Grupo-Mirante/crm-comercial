# Configuração com senhas — nunca versionar
.env
.env.*
!.env.example

# Arquivos gerados em uso
/storage/logs/*
/storage/cache/*
/storage/backups/*
/storage/exports/*
/storage/uploads/*
/storage/sessions/*
/storage/instalado.lock
!/storage/*/.gitkeep

