{
    "name": "grupo-mirante/crm-comercial",
    "description": "CRM Comercial do Grupo Mirante de Comunicação",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "dompdf/dompdf": "^3.1",
        "phpmailer/phpmailer": "^6.10",
        "phpoffice/phpspreadsheet": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" },
        "files": ["app/Helpers/functions.php"]
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": { "php": "8.5.4" }
    },
    "scripts": {
        "test": "phpunit"
    }
}
