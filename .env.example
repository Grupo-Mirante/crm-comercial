# =====================================================================
#  CRM Comercial · Grupo Mirante de Comunicação — arquivo de configuração
#  Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
#  NUNCA envie o .env para repositórios ou para terceiros.
# =====================================================================

# --- Aplicação -------------------------------------------------------
APP_NAME="CRM Comercial · Grupo Mirante"
# production em produção; staging para homologação; local no computador do desenvolvedor
APP_ENV=production
# Mostra detalhes técnicos dos erros na tela. Mantenha false (com APP_ENV=production ele é ignorado).
APP_DEBUG=false
# Endereço completo onde o sistema será acessado, sem barra no final
APP_URL=https://crm.seudominio.com.br
APP_TIMEZONE=America/Sao_Paulo
# true somente se o servidor estiver atrás de um proxy/balanceador que termina o HTTPS
APP_TRUST_PROXY=false

# --- Banco de dados MySQL --------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_grupo_mirante
DB_USERNAME=crm_mirante
DB_PASSWORD=
# Opcional: caminho do socket do MySQL (deixe vazio para usar host e porta)
# Dica: o instalador (/instalar ou php instalar.php) preenche este arquivo para você.
DB_SOCKET=

# --- Sessão ----------------------------------------------------------
SESSION_COOKIE=crm_mirante
# Encerra a sessão após este tempo sem uso (minutos)
SESSION_IDLE_MINUTES=120
# Tempo máximo de uma sessão, mesmo em uso (RN-77: até 12 horas = 720 minutos)
SESSION_ABSOLUTE_MINUTES=720

# --- E-mail (opcional) -----------------------------------------------
# Sem MAIL_HOST, o sistema não envia e-mails; avisos ficam dentro do CRM.
MAIL_HOST=
MAIL_PORT=587
# tls, ssl ou none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="CRM Grupo Mirante"

# --- Arquivos --------------------------------------------------------
# Tamanho máximo de cada anexo (MB)
UPLOAD_MAX_MB=10

# --- Backup ----------------------------------------------------------
# Pasta onde os backups serão gravados (fora da pasta public)
BACKUP_DIR=
BACKUP_RETENCAO_DIAS=30
# Caminhos dos programas do MySQL, se não estiverem no PATH do servidor
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql
